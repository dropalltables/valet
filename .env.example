# Copy to .env. Everything else (agent tokens, GitHub token, projects) is set in the UI.

# Required
POSTGRES_PASSWORD=change-me
# Encrypts stored credentials. Generate: openssl rand -base64 32
VALET_SECRET_KEY=

# Recommended: password for the web UI. Leave empty to disable (local use only).
VALET_PASSWORD=

# URL the UI is served at (used in pull request bodies and portal URLs).
VALET_BASE_URL=http://localhost:3000
# Portals live at t-<thread>-p<port>.<this>; defaults to the host[:port] of VALET_BASE_URL.
VALET_PORTAL_DOMAIN=

# Host interface and port for the UI. Use 0.0.0.0 only behind a reverse proxy or firewall.
VALET_BIND=127.0.0.1
VALET_PORT=3000

# Sandboxes
VALET_SANDBOX_IMAGE=valet-sandbox:latest
VALET_IDLE_PAUSE_MINUTES=10
VALET_SANDBOX_MEMORY=4g
VALET_SANDBOX_CPUS=2
VALET_MAX_RUNNING_SANDBOXES=8
