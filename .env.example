# Copy to .env. Agent accounts, the GitHub token, and projects are set in the UI.

# Required
POSTGRES_PASSWORD=change-me
# Encrypts stored credentials. Generate: openssl rand -base64 32
VALET_SECRET_KEY=

# Recommended: password for the web UI. Leave empty to disable (local use only).
VALET_PASSWORD=

# URL the UI is served at (used in pull request bodies and service URLs).
VALET_BASE_URL=http://localhost:3000
# Services live at t-<thread>-p<port>.<this>; defaults to the host[:port] of VALET_BASE_URL.
VALET_SERVICE_DOMAIN=

# Host interface and port for the UI. Use 0.0.0.0 only behind a reverse proxy or firewall.
VALET_BIND=127.0.0.1
VALET_PORT=3000

# Registry prefix for the valet-* images (e.g. ghcr.io/your-org/); empty builds them locally.
VALET_IMAGE_PREFIX=

# Sandboxes. Empty applies VALET_IMAGE_PREFIX; a value here overrides it. Core pulls the
# image when it is missing, unless the name has no registry host and so is built here.
VALET_SANDBOX_IMAGE=
VALET_IDLE_PAUSE_MINUTES=10
VALET_SANDBOX_MEMORY=4g
VALET_SANDBOX_CPUS=2
VALET_SANDBOX_PIDS=2048
VALET_MAX_RUNNING_SANDBOXES=8
VALET_SNAPSHOTS=1
VALET_SNAPSHOT_MAX_GB=20

# Discovered from core's own container when empty; set them only when core runs outside compose.
VALET_DOCKER_NETWORK=
VALET_REPOS_VOLUME=

# Traefik labels on the web service (Coolify): the network the proxy shares with web, and
# the name of a DNS-challenge certificate resolver that can issue the wildcard.
VALET_PROXY_NETWORK=
VALET_CERT_RESOLVER=letsencrypt
